# 必填：OpenAI API 密钥。不要把真实密钥提交到 Git。
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# 公众号“开发接口管理”中的 AppID / AppSecret。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 没有密钥时设为 true，可完整体验本地界面与文件产出，但不会连接外部服务。
DEMO_MODE=true

PORT=3210

# 选题队列扫描频率，默认每 10 分钟检查一次到期任务。
SCHEDULE_CRON=*/10 * * * *
